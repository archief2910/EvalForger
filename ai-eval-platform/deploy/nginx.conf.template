# The console is the only public origin. Everything the SPA calls is proxied
# here, so the API needs no CORS configuration and the browser sees one host.
#
# This file is a TEMPLATE. The nginx image substitutes ${PORT}, ${API_SCHEME}
# and ${API_HOST} at container start, which is what lets the same image serve:
#   - Compose:  PORT=80    API_SCHEME=http   API_HOST=server:8000
#   - Render:   PORT=$PORT API_SCHEME=https  API_HOST=<api-service>.onrender.com
#
# Only variables present in the environment are substituted, so nginx's own
# $host / $remote_addr stay untouched.

server {
    # PaaS platforms hand the container a port and health-check it there.
    listen ${PORT};
    server_name _;

    # When API_HOST is a public Render hostname, nginx must present that name
    # in TLS SNI and in the Host header. Sending the web service's own host
    # would make Render route the proxied request back to this web service.
    proxy_ssl_server_name on;

    # Ingest batches and long dashboard/compare queries both need room.
    client_max_body_size 32m;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # OTLP ingest: exporters append /v1/traces to a base URL, so both spellings
    # are forwarded. No buffering, because a trace should land as it arrives.
    location /v1/ {
        proxy_pass ${API_SCHEME}://${API_HOST};
        proxy_request_buffering off;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /otel/ {
        proxy_pass ${API_SCHEME}://${API_HOST};
        proxy_request_buffering off;
        proxy_set_header Host ${API_HOST};
    }

    location /api/ {
        proxy_pass ${API_SCHEME}://${API_HOST};
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location /mcp {
        proxy_pass ${API_SCHEME}://${API_HOST};
        proxy_http_version 1.1;
        proxy_set_header Host ${API_HOST};
        # The MCP Streamable HTTP transport keeps the response open.
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location /oauth/ {
        proxy_pass ${API_SCHEME}://${API_HOST};
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /.well-known/ {
        proxy_pass ${API_SCHEME}://${API_HOST};
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        proxy_pass ${API_SCHEME}://${API_HOST};
        proxy_set_header Host ${API_HOST};
        access_log off;
    }

    # The SPA is a client-side router: unknown paths are routes, not 404s.
    location / {
        try_files $uri $uri/ /index.html;
    }
}