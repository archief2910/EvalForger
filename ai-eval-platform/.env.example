# Copy to `.env` and edit. Compose reads it automatically.
#
# The provider key is the only secret here that matters for a demo: without it,
# LLM judges fall back to labelled deterministic heuristics and optimisation
# candidates all score the same. Everything else still works.

# --- provider (LLM judges, the optimizer) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- ports on your machine ---
WEB_PORT=8080
API_PORT=8000

# --- access control ---
# `off`    : anyone who can reach the port can read and write. Fine for a demo,
#            a hackathon judge, or a laptop.
# `required`: every /api/v1 route needs a key or an OAuth token. Mint one with
#            `docker compose run --rm create-key`.
AUTH_MODE=off

# Must be the URL a browser reaches: it is published in OAuth discovery
# documents and used as the token audience.
PUBLIC_BASE_URL=http://localhost:8080

# --- database ---
POSTGRES_PASSWORD=evalforge

# --- sandbox + background jobs (defaults are fine) ---
SANDBOX_IMAGE=python:3.12-slim
MONITOR_INTERVAL_SECONDS=60
RETENTION_SWEEP_SECONDS=3600

# Override only if your registry does not have the Go version go.mod asks for;
# the builder then downloads the right toolchain itself.
# GO_IMAGE=golang:1.26-bookworm